<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Forgot Password</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="icon" type="image/x-icon" href="/image/favicon.ico">

</head>

<body class="bg-gray-100 min-h-screen flex flex-col">
  <%- include('partials/header', { user }) %>
  <div class="flex justify-center bg-gray-100 pt-24 pb-12">
    <div class="bg-white p-8 rounded-xl shadow-md w-full max-w-md mt-24">
      <h2 class="text-xl font-semibold mb-4">Forgot Password</h2>

      <% if (message) { %>
      <p class="mb-4 text-green-600"><%= message %></p>
      <% } %>

      <form action="/auth/forgot-password" method="POST" class="space-y-4">
        <input type="email" name="email" placeholder="Enter your email" required
          class="w-full px-3 py-2 border rounded-lg">
        <button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg">
          Send Reset Link
        </button>
      </form>

      <p class="mt-4 text-sm text-center">
        <a href="/" class="text-blue-600 hover:underline">Back to Login</a>
      </p>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>

</html>