<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard | Note-Taker</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="icon" type="image/x-icon" href="/image/favicon.ico">
</head>

<body class="bg-gray-100 min-h-screen flex flex-col">

  <%- include('partials/header') %>

  <!-- Main Container -->
  <main class="flex flex-1 flex-col md:flex-row p-4 md:p-6 gap-4 md:gap-8">

    <!-- Sidebar -->
    <aside id="sidebar"
      class="hidden md:flex w-full md:w-1/3 lg:w-1/4 bg-white p-4 rounded-md shadow-xl flex-col">

      <!-- Search -->
      <input type="text" id="search-notes"
        class="w-full mb-3 px-3 py-2 border border-gray-300 rounded-md focus:ring focus:ring-blue-500"
        placeholder="Search notes..." />

      <!-- Filter -->
      <select id="filter-notes"
        class="mb-4 px-3 py-2 border border-gray-300 rounded-md focus:ring focus:ring-blue-500">
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="starred">Starred only</option>
        <option value="unstarred">Unstarred only</option>
      </select>

      <!-- Notes list -->
      <ul id="notes-list" class="flex-1 overflow-y-auto space-y-2"></ul>

      <!-- Add button -->
      <button id="new-note-btn"
        class="mt-4 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
        + Add Note
      </button>
    </aside>

    <!-- Note Editor -->
    <section class="flex-1 bg-white p-6 rounded-md shadow-xl flex flex-col">
      <input type="text" id="note-title" placeholder="Note Title"
        class="border-b border-gray-300 text-lg md:text-xl font-semibold mb-4 focus:outline-none focus:border-blue-500 p-1">

      <textarea id="note-content" placeholder="Write your note..."
        class="flex-1 resize-none p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>

      <div class="mt-4 flex flex-col md:flex-row justify-end gap-2">
        <button id="delete-note-btn"
          class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">Delete</button>
        <button id="update-note-btn"
          class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-600">Update</button>
        <button id="save-note-btn"
          class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600">Save</button>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    // Toggle sidebar on mobile
    document.getElementById('mobile-toggle')?.addEventListener('click', () => {
      const sb = document.getElementById('sidebar');
      sb.classList.toggle('hidden');
    });
  </script>
</body>
</html>
