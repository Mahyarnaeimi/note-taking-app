<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Register</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="icon" type="image/x-icon" href="/public/image/favicon.ico">

</head>

<body class="bg-gray-100 min-h-screen flex flex-col">
  <%- include('partials/header', { user }) %>
  <div class="flex justify-center bg-gray-100 pt-24 pb-12">
    <div class="bg-white p-8 rounded-xl shadow-md w-full max-w-md mt-24">
      <h2 class="text-xl font-semibold mb-4">Register</h2>

      <% if (error) { %>
      <p class="text-red-500 mb-4"><%= error %></p>
      <% } %>

      <form action="/auth/register" method="POST" class="space-y-4">
        <input type="text" name="displayName" placeholder="Full Name" required
          class="w-full px-3 py-2 border rounded-lg">
        <input type="email" name="email" placeholder="Email" required class="w-full px-3 py-2 border rounded-lg">
        <input type="password" name="password" placeholder="Password" required
          class="w-full px-3 py-2 border rounded-lg">
        <button type="submit" class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg">
          Register
        </button>
      </form>

      <p class="mt-4 text-sm text-center">
        Already have an account?
        <a href="/" class="text-blue-600 hover:underline">Login</a>
      </p>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>

</html>